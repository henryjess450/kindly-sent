# Copy to .env and fill in. Never commit .env.

# The public address of the site, no trailing slash.
SITE_URL=https://kindlysent.ca

# Where the SQLite database lives (the Docker volume mounts /app/data).
DATA_DIR=./data

# Outgoing email: a Gmail address and its App Password (Google Account >
# Security > 2-Step Verification > App passwords). Coastline's two GMAIL_
# lines can be copied here as-is. Emails come from "Kindly Sent <that address>".
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Or any other SMTP server instead of Gmail (leave the GMAIL_ lines blank):
# SMTP_HOST=smtp.titan.email
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Kindly Sent <same address as SMTP_USER>"

# Outside production, emails are saved to /dev/outbox instead of sent.
# Set to true to really send while developing.
EMAIL_SEND_IN_DEV=false

# Comma-separated emails that can open /admin.
ADMIN_EMAILS=

# Payments (Square). Leave blank in development to use the demo payment.
# The same four lines from Coastline's .env work here (SQUARE_ENVIRONMENT is
# accepted too). sandbox or production.
SQUARE_ENV=sandbox
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# GIFs and stickers on group cards. Free key: developers.giphy.com >
# Create an App > API. Without it, the GIF button says GIFs aren't on yet.
GIPHY_API_KEY=
