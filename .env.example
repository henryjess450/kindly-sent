# Copy to .env and fill in. Never commit .env.

# The public address of the site, no trailing slash.
SITE_URL=https://kindlysent.ca

# Where the SQLite database lives (the Docker volume mounts /app/data).
DATA_DIR=./data

# Outgoing email. Gmail works with an App Password (same as Coastline Prints).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kindly Sent <cards@kindlysent.ca>"

# Outside production, emails are saved to /dev/outbox instead of sent.
# Set to true to really send while developing.
EMAIL_SEND_IN_DEV=false

# Comma-separated emails that can open /admin.
ADMIN_EMAILS=

# Payments (Square). Leave blank in development to use the demo payment.
# Sandbox keys first: developer.squareup.com > your app > Sandbox.
SQUARE_ENV=sandbox
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# Gift cards (Tremendous). Leave blank in development for demo gift links.
# Sandbox: testflight.tremendous.com. List product IDs: node scripts/gift-catalog.mjs
TREMENDOUS_ENV=sandbox
TREMENDOUS_API_KEY=
TREMENDOUS_FUNDING_SOURCE=BALANCE
