# Copy to .env and fill in. Never commit .env.

# The public address of the site, no trailing slash.
SITE_URL=https://kindlysent.ca

# Where the SQLite database lives (the Docker volume mounts /app/data).
DATA_DIR=./data

# Outgoing email. Gmail works with an App Password (same as Coastline Prints).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Kindly Sent <cards@kindlysent.ca>"

# Outside production, emails are saved to /dev/outbox instead of sent.
# Set to true to really send while developing.
EMAIL_SEND_IN_DEV=false

# Comma-separated emails that can open /admin.
ADMIN_EMAILS=

# Payments (Square). Leave blank in development to use the demo payment.
# Sandbox keys first: developer.squareup.com > your app > Sandbox.
SQUARE_ENV=sandbox
SQUARE_APPLICATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# Gift cards. Tango Card (default) gives the real card number and PIN, which
# are printed inside the card. Tremendous only gives a redeem link.
# Leave the keys blank in development to get demo codes.
GIFT_PROVIDER=tango
TANGO_ENV=sandbox
TANGO_PLATFORM_NAME=
TANGO_PLATFORM_KEY=
TANGO_ACCOUNT_ID=
TANGO_CUSTOMER_ID=
# Optional alternative:
TREMENDOUS_ENV=sandbox
TREMENDOUS_API_KEY=
TREMENDOUS_FUNDING_SOURCE=BALANCE

# Encrypts gift card numbers and PINs in the database. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back it up somewhere safe: without it, unopened gift codes can't be read.
GIFT_SECRET_KEY=
